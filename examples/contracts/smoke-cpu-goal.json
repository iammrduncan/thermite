  "goals": [
    {
      "id": "faster",
      "description": "the large case reaches the speed this goal sets, in floating-point operations a second",
      "verify": {
        "type": "metric_threshold",
        "metric": "flops_per_s",
        "op": ">=",
        "value": 10000000000,
        "cells": [
          "large"
        ]
      }
    }
  ],
  "deliverable": "a kernel that reaches the speed goal and still computes the right product",
  "insufficient": [
    "calling the reference implementation",
    "timing the kernel from inside"
  ]

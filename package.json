{
  "name": "thermite",
  "version": "0.1.0",
  "private": true,
  "description": "Autoresearch harness: agents propose, code they cannot touch judges, one control service steers every campaign.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "thermite": "dist/cli/thermite/main.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postinstall": "node scripts/patch-pi-ai.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node scripts/test.mjs",
    "check:public": "node scripts/checks/public.mjs",
    "check:sizes": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/checks/sizes.ts",
    "check:imports": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/checks/imports.ts",
    "docs:install": "npm --prefix docs/_site ci",
    "docs:dev": "npm --prefix docs/_site run dev",
    "docs:build": "npm --prefix docs/_site run build",
    "docs:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/docs/check.mjs",
    "docs:credits": "node scripts/docs/credits-page.mjs",
    "docs:agents": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/docs/agents-page.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:public && npm run check:sizes && npm run check:imports",
    "dev:init": "node scripts/dev/init.mjs",
    "smoke:compose": "node scripts/acceptance/compose-smoke.mjs",
    "acceptance:judge": "node scripts/acceptance/judge.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/nkeys": "2.0.3",
    "@nats-io/transport-node": "3.4.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}

{
  "name": "thermite",
  "version": "0.1.0",
  "private": true,
  "description": "Autoresearch harness: agents propose, code they cannot touch judges, one control service steers every campaign.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "thermite": "dist/cli/thermite.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postinstall": "node scripts/patch-pi-ai.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node scripts/test.mjs",
    "check:public": "node scripts/check-public.mjs",
    "check:sizes": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-sizes.ts",
    "check:imports": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-imports.ts",
    "docs:install": "npm --prefix docs/_site ci",
    "docs:dev": "npm --prefix docs/_site run dev",
    "docs:build": "npm --prefix docs/_site run build",
    "docs:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/docs-check.mjs",
    "docs:credits": "node scripts/credits-page.mjs",
    "docs:agents": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/agents-page.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:public && npm run check:sizes && npm run check:imports",
    "dev:init": "node scripts/dev-init.mjs",
    "smoke:compose": "node scripts/compose-smoke.mjs",
    "acceptance:judge": "node scripts/judge-acceptance.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}

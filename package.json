{
  "name": "thermite",
  "version": "0.1.0",
  "private": true,
  "description": "Autoresearch harness: agents propose, code they cannot touch judges, one control service steers every campaign.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "thermite": "dist/cli/thermite.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node scripts/test.mjs",
    "check:public": "node scripts/check-public.mjs",
    "docs:install": "npm --prefix docs/_site ci",
    "docs:dev": "npm --prefix docs/_site run dev",
    "docs:build": "npm --prefix docs/_site run build",
    "docs:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/docs-check.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:public",
    "dev:init": "node scripts/dev-init.mjs",
    "smoke:compose": "node scripts/compose-smoke.mjs",
    "acceptance:judge": "node scripts/judge-acceptance.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.0",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "typescript": "5.9.3"
  }
}

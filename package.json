{
  "name": "thermite",
  "version": "0.1.0",
  "private": true,
  "description": "Autoresearch harness: agents propose, code they cannot touch judges, one control service steers every campaign.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "thermite": "dist/cli/thermite/main.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postinstall": "node scripts/patch-pi-ai.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node scripts/test.mjs",
    "check:public": "node scripts/checks/public.mjs",
    "check:sizes": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/checks/sizes.ts",
    "check:imports": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/checks/imports.ts",
    "bench:views": "node --expose-gc --max-old-space-size=4096 --experimental-strip-types --disable-warning=ExperimentalWarning scripts/bench/views.ts",
    "check:loose-ends": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/checks/loose-ends.ts",
    "docs:install": "npm --prefix docs/_site ci",
    "docs:dev": "npm --prefix docs/_site run dev",
    "docs:build": "npm --prefix docs/_site run build",
    "docs:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/docs/check.mjs",
    "docs:credits": "node scripts/docs/credits-page.mjs",
    "docs:agents": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/docs/agents-page.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:public && npm run check:sizes && npm run check:imports && npm run check:loose-ends",
    "dev:init": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli/thermite/main.ts local init .dev",
    "smoke:compose": "node scripts/acceptance/compose-smoke.mjs",
    "acceptance:agents": "node scripts/acceptance/agents.mjs",
    "acceptance:backup": "node scripts/acceptance/backup.mjs",
    "acceptance:bus": "node scripts/acceptance/bus.mjs",
    "acceptance:campaign": "node scripts/acceptance/campaign.mjs",
    "acceptance:claude": "node scripts/acceptance/claude.mjs",
    "acceptance:claude-real": "node scripts/acceptance/claude-real.mjs",
    "acceptance:cluster": "node scripts/acceptance/cluster.mjs",
    "acceptance:codex": "node scripts/acceptance/codex.mjs",
    "acceptance:control": "node scripts/acceptance/control.mjs",
    "acceptance:judge": "node scripts/acceptance/judge.mjs",
    "acceptance:leaf": "node scripts/acceptance/leaf.mjs",
    "acceptance:machine": "node scripts/acceptance/machine.mjs",
    "acceptance:multigpu": "node scripts/acceptance/multigpu.mjs",
    "acceptance:quick-start": "node scripts/acceptance/quick-start.mjs",
    "acceptance:research-longrun": "node scripts/acceptance/research-longrun.mjs",
    "acceptance:rig-deploy": "node scripts/acceptance/rig-deploy.mjs",
    "acceptance:rig-image": "node scripts/acceptance/rig-image.mjs",
    "acceptance:runpod": "node scripts/acceptance/runpod.mjs",
    "acceptance:runpod-paid": "node scripts/acceptance/runpod-paid.mjs",
    "acceptance:steering": "node scripts/acceptance/steering.mjs",
    "acceptance:terminal": "node scripts/acceptance/terminal.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/nkeys": "2.0.3",
    "@nats-io/transport-node": "3.4.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}

{
  "name": "thermite",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Autoresearch harness: agents propose, code they cannot touch judges, one control service steers every campaign.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node scripts/test.mjs",
    "check:public": "node scripts/checks/public.mjs",
    "check:design": "node scripts/checks/design-system.mjs",
    "design:dev": "npm --workspace=@iammrduncan/magnesium run dev",
    "design:build": "npm --workspace=@iammrduncan/magnesium run build",
    "ui:dev": "npm --workspace=@thermite/ui run dev",
    "build:ui": "npm --workspace=@thermite/ui run build",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "22.20.5",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2"
  }
}

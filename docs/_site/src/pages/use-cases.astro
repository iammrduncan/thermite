---
// The use cases' overview: what Thermite can be pointed at, by field, with a filter by field and
// by persona. Each use case and each persona has its full page in the documentation (use-cases/),
// where llms.txt and the Markdown copies carry it too; this page reads them.
import AudienceIcon from "../components/site/AudienceIcon.astro";
import Cmd from "../components/site/Cmd.astro";
import FieldIcon from "../components/site/FieldIcon.astro";
import { useCasePages } from "../data/use-case-pages";
import { fields, modes, personaHref, personas } from "../data/use-cases.mjs";
import Site from "../layouts/Site.astro";

const cases = await useCasePages();
const modeLabel = Object.fromEntries(modes.map((m) => [m.key, m.label]));
const personaShort = Object.fromEntries(personas.map((p) => [p.key, p.short]));
const rowNames = (mode: string) => (mode === "research" ? ["Counts", "Checked", "Decided"] : ["Measures", "Holds", "Hidden"]);
const byField = fields
  .map((f) => ({ ...f, cases: cases.filter((c) => c.field === f.key) }))
  .filter((f) => f.cases.length > 0);
const count = (key: string) => cases.filter((c) => c.personas.includes(key)).length;
---

<Site
  title="Use cases: what you can point Thermite at"
  description="What Thermite can be used for, in software, AI, science, healthcare, agriculture, energy, operations, robotics and finance: for each, what the judge measures, what must hold and what stays hidden from the agents."
  section="use-cases"
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Use cases</p>
      <h1 class="h1">Point it at anything a program can score.</h1>
      <p class="lede">
        If a program can build your project, run it and say how good the result is, Thermite can put agents on it for
        days, and its judge keeps only what it confirms.
      </p>
    </div>
  </section>

  <div class="filters" data-filters hidden>
    <div class="wrap bar">
      <div class="chips" role="group" aria-label="Field">
        <button type="button" data-field="all" aria-pressed="true">All</button>
        {
          byField.map((f) => (
            <button type="button" data-field={f.key} aria-pressed="false">
              {f.short ?? f.label}
            </button>
          ))
        }
      </div>
      <label class="who-pick">
        <span class="sr-only">Who it's for</span>
        <select data-persona aria-label="Who it's for">
          <option value="all">Everyone</option>
          {personas.map((p) => <option value={p.key}>{p.name}</option>)}
        </select>
      </label>
    </div>
  </div>

  <section class="section cases" id="cases">
    <div class="wrap">
      <p class="shown small" aria-live="polite" data-shown>{cases.length} use cases</p>
      {
        byField.map((f) => (
          <section class="field" id={f.key} data-field-section={f.key}>
            <header class="field-head">
              <FieldIcon name={f.key} />
              <div>
                <h2 class="h3">{f.label}</h2>
                <p class="small">{f.blurb}</p>
              </div>
            </header>
            <div class="grid cards">
              {f.cases.map((c) => (
                <a class="card uc" href={c.href} data-field={c.field} data-personas={c.personas.join(" ")}>
                  <span class={`tag ${c.mode}`}>{modeLabel[c.mode]}</span>
                  <h3 class="h3">{c.title}</h3>
                  <p>{c.summary}</p>
                  <dl class="spec">
                    {c.measure.map((part, i) => (
                      <div>
                        <dt>{rowNames(c.mode)[i]}</dt>
                        <dd>{part.charAt(0).toUpperCase() + part.slice(1)}</dd>
                      </div>
                    ))}
                  </dl>
                  <p class="for">{c.personas.map((p) => personaShort[p]).join(" · ")}</p>
                </a>
              ))}
            </div>
          </section>
        ))
      }
      <p class="empty" data-empty hidden>
        No use case for that pair yet. <button type="button" data-reset>Show them all</button>
      </p>
    </div>
  </section>

  <section class="section" id="who">
    <div class="wrap">
      <div class="head" data-reveal>
        <p class="eyebrow">Who it's for</p>
        <h2 class="h2">The same judge, from one laptop to a fleet.</h2>
      </div>
      <div class="grid four">
        {
          personas.map((p) => (
            <div class="card persona" data-reveal>
              <AudienceIcon name={p.key} />
              <h3 class="h3">{p.name}</h3>
              <p>{p.pitch}</p>
              <div class="links">
                <a href={personaHref(p.key)}>
                  Read the guide <span aria-hidden="true">→</span>
                </a>
                <a href={`?for=${p.key}#cases`} data-show={p.key}>
                  Show its {count(p.key)} use cases
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal>
        <p class="eyebrow">Three modes</p>
        <h2 class="h2">Every campaign is one of three kinds.</h2>
        <p class="lede">
          Each use case names its mode. <a href="/how-to/campaigns/choose-a-mode/">Choose a campaign mode</a> helps you
          pick one for your own project.
        </p>
      </div>
      <div class="card table-card" data-reveal>
        <table class="facts">
          <thead>
            <tr><th>Mode</th><th>You want to</th><th>It ends when</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="tag climb">hill climb</span></td>
              <td>Push one number as far as it goes, without breaking anything else</td>
              <td>You stop it, or a budget or stop time you set runs out</td>
            </tr>
            <tr>
              <td><span class="tag goal">goal</span></td>
              <td>Make something work, checked by a list of goals</td>
              <td>Every required goal is met, or the evidence shows it can't be</td>
            </tr>
            <tr>
              <td><span class="tag research">research</span></td>
              <td>Find out what is known, with sources you can check</td>
              <td>Every question is answered, or the research stops adding</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section last">
    <div class="wrap">
      <div class="cta" data-reveal>
        <p class="eyebrow">Try it</p>
        <h2 class="h2">Twenty minutes to a first verdict.</h2>
        <p class="lede">Install it on one computer, or ask your own AI agent to:</p>
        <Cmd prompt="›" text="Set up Thermite on this computer for me: follow https://usethermite.com/llm-setup.txt" />
        <div class="btns">
          <a class="btn primary" href="/tutorials/first-run/">Install on one machine</a>
          <a class="btn" href="/tutorials/your-own-project/">Start on your own project</a>
        </div>
      </div>
    </div>
  </section>
</Site>

<script>
  // The filter: a field and a persona, kept in the address (?field=…&for=…) so a link can open
  // the page filtered. Without scripts, the filter bar stays hidden and every use case shows.
  const root = document.querySelector<HTMLElement>("[data-filters]");
  const select = document.querySelector<HTMLSelectElement>("select[data-persona]");
  const chips = [...document.querySelectorAll<HTMLButtonElement>("button[data-field]")];
  const cards = [...document.querySelectorAll<HTMLElement>("a.uc")];
  const sections = [...document.querySelectorAll<HTMLElement>("[data-field-section]")];
  const shown = document.querySelector("[data-shown]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const params = new URLSearchParams(location.search);
  let field = params.get("field") ?? "all";
  let persona = params.get("for") ?? "all";
  if (!chips.some((c) => c.dataset.field === field)) field = "all";
  if (select && ![...select.options].some((o) => o.value === persona)) persona = "all";

  function apply(write: boolean) {
    let n = 0;
    for (const card of cards) {
      const ok =
        (field === "all" || card.dataset.field === field) &&
        (persona === "all" || (card.dataset.personas ?? "").split(" ").includes(persona));
      card.hidden = !ok;
      if (ok) n++;
    }
    for (const s of sections) s.hidden = !cards.some((c) => !c.hidden && c.dataset.field === s.dataset.fieldSection);
    for (const c of chips) c.setAttribute("aria-pressed", String(c.dataset.field === field));
    if (select) select.value = persona;
    if (shown) shown.textContent = `${n} use case${n === 1 ? "" : "s"}`;
    if (empty) empty.hidden = n > 0;
    if (write) {
      const q = new URLSearchParams();
      if (field !== "all") q.set("field", field);
      if (persona !== "all") q.set("for", persona);
      const s = q.toString();
      history.replaceState(null, "", `${location.pathname}${s ? `?${s}` : ""}${location.hash}`);
    }
  }

  if (root) {
    root.hidden = false;
    for (const c of chips)
      c.addEventListener("click", () => {
        field = c.dataset.field ?? "all";
        apply(true);
      });
    select?.addEventListener("change", () => {
      persona = select.value;
      apply(true);
    });
    document.querySelector("[data-reset]")?.addEventListener("click", () => {
      field = "all";
      persona = "all";
      apply(true);
    });
    for (const a of document.querySelectorAll<HTMLAnchorElement>("a[data-show]"))
      a.addEventListener("click", (e) => {
        e.preventDefault();
        field = "all";
        persona = a.dataset.show ?? "all";
        apply(true);
        document.getElementById("cases")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    apply(false);
  }
</script>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3rem);
    background: radial-gradient(60% 90% at 90% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%);
  }
  .hero .h1 {
    max-width: 52rem;
  }
  .hero .lede {
    max-width: 46rem;
  }
  .filters {
    position: sticky;
    top: 3.75rem;
    z-index: 40;
    border-block: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .filters[hidden] {
    display: none;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.7rem;
  }
  .chips {
    display: flex;
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .chips::-webkit-scrollbar {
    display: none;
  }
  .chips button,
  .who-pick select,
  .empty button {
    font: inherit;
    font-size: 0.85rem;
    color: var(--ink-2);
    background: var(--panel);
    border: 1px solid var(--rule-2);
    border-radius: 999px;
    padding: 0.32rem 0.8rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .chips button:hover {
    border-color: var(--dim);
  }
  .chips button[aria-pressed="true"] {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
  }
  .who-pick select {
    padding-right: 1.8rem;
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%),
      linear-gradient(135deg, var(--muted) 50%, transparent 50%);
    background-position:
      calc(100% - 0.95rem) 55%,
      calc(100% - 0.65rem) 55%;
    background-size: 0.3rem 0.3rem;
    background-repeat: no-repeat;
  }
  .cases {
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
  }
  .shown {
    margin: 0 0 1.25rem;
  }
  .field {
    scroll-margin-top: 8rem;
  }
  .field + .field {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .field[hidden],
  .uc[hidden] {
    display: none;
  }
  .field-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.1rem;
  }
  .field-head .h3 {
    margin: 0;
    font-size: 1.3rem;
  }
  .field-head p {
    margin: 0.15rem 0 0;
  }
  .cards {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .uc {
    display: flex;
    flex-direction: column;
  }
  .uc .h3 {
    margin-top: 0.9rem;
    font-size: 1.12rem;
    line-height: 1.3;
  }
  .uc > p {
    font-size: 0.92rem;
  }
  .spec {
    display: grid;
    gap: 0.35rem;
    margin: 1rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
    font-size: 0.82rem;
  }
  .spec div {
    display: grid;
    grid-template-columns: 4.6rem minmax(0, 1fr);
    gap: 0.5rem;
  }
  .spec dt {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    color: var(--dim);
    padding-top: 0.12rem;
  }
  .spec dd {
    margin: 0;
    color: var(--ink-2);
  }
  .uc .for {
    margin-top: auto;
    padding-top: 0.9rem;
    font-size: 0.78rem;
    color: var(--dim);
  }
  .empty {
    color: var(--muted);
  }
  .empty[hidden] {
    display: none;
  }
  .persona .h3 {
    margin-top: 1rem;
  }
  .links {
    display: grid;
    gap: 0.35rem;
    margin-top: 1rem;
    font-size: 0.9rem;
  }
  .links a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 560;
  }
  .links a + a {
    color: var(--muted);
    font-weight: 450;
  }
  .links a:hover {
    text-decoration: underline;
  }
  .head .lede a {
    color: var(--ink-2);
  }
  .table-card {
    padding: 0.4rem;
    overflow-x: auto;
  }
  .table-card th {
    width: auto;
    color: var(--muted);
    font-weight: 500;
    font-size: 0.82rem;
  }
  .table-card td:first-child {
    width: 8rem;
  }
  .table-card td:nth-child(2) {
    color: var(--ink-2);
  }
  .last {
    padding-top: 0;
    border-top: 0 !important;
  }
  .cta .cmd {
    margin-top: 1.25rem;
  }
  @media (min-width: 64rem) {
    .chips {
      flex-wrap: wrap;
      overflow: visible;
    }
  }
  @media (max-width: 40rem) {
    .bar {
      flex-direction: column;
      align-items: stretch;
      gap: 0.55rem;
    }
    .who-pick select {
      width: 100%;
    }
  }
</style>

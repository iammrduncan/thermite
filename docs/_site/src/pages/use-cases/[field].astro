---
// One field's use cases, at /use-cases/<field>/: what Thermite does in that field, and a card for
// each use case, whose full page is in the documentation (use-cases/<field>/<case>/).
import AudienceIcon from "../../components/site/AudienceIcon.astro";
import Cmd from "../../components/site/Cmd.astro";
import FieldIcon from "../../components/site/FieldIcon.astro";
import { useCasePages } from "../../data/use-case-pages";
import { fields, modes, personaHref, personas } from "../../data/use-cases.mjs";
import Site from "../../layouts/Site.astro";

export async function getStaticPaths() {
  const cases = await useCasePages();
  return fields.filter((f) => cases.some((c) => c.field === f.key)).map((f) => ({ params: { field: f.key } }));
}

const { field: key } = Astro.params;
const field = fields.find((f) => f.key === key);
if (!field) throw new Error(`no field ${key}`);
const all = await useCasePages();
const cases = all.filter((c) => c.field === key);
const others = fields.filter((f) => f.key !== key && all.some((c) => c.field === f.key));
const modeLabel = Object.fromEntries(modes.map((m) => [m.key, m.label]));
const personaShort = Object.fromEntries(personas.map((p) => [p.key, p.short]));
const rowNames = (mode: string) => (mode === "research" ? ["Counts", "Checked", "Decided"] : ["Measures", "Holds", "Hidden"]);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const suited = personas.filter((p) => cases.some((c) => c.personas.includes(p.key)));
---

<Site
  title={`${field.label}: Thermite use cases`}
  description={`${field.blurb} ${cases.length} use cases for Thermite in ${field.label.toLowerCase()}: what the judge measures, what must hold and what stays hidden.`}
  section="use-cases"
>
  <section class="hero">
    <div class="wrap">
      <nav class="crumbs small" aria-label="Breadcrumb">
        <a href="/use-cases/">Use cases</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{field.label}</span>
      </nav>
      <nav class="switch" aria-label="Fields">
        {
          fields
            .filter((f) => f.key === key || others.includes(f))
            .map((f) => (
              <a href={`/use-cases/${f.key}/`} aria-current={f.key === key ? "page" : undefined}>
                {f.short ?? f.label}
              </a>
            ))
        }
      </nav>
      <div class="title">
        <FieldIcon name={field.key} />
        <p class="eyebrow">Thermite for {field.label}</p>
      </div>
      <h1 class="h1">{field.headline}</h1>
      <p class="lede">{field.intro}</p>
      <div class="btns">
        <a class="btn primary" href="/tutorials/your-own-project/">Start on your own project</a>
        <a class="btn" href="/how-to/campaigns/write-a-kit/">Write a kit</a>
      </div>
    </div>
  </section>

  <section class="section cases">
    <div class="wrap list">
      {
        cases.map((c) => (
          <a class="row" href={c.href}>
            <div class="main">
              <span class={`tag ${c.mode}`}>{modeLabel[c.mode]}</span>
              <h2 class="h3">{c.title}</h2>
              <p>{c.summary}</p>
              <p class="for">For {c.personas.map((p) => personaShort[p]).join(" · ")}</p>
            </div>
            <dl class="spec">
              {c.measure.map((part, i) => (
                <div>
                  <dt>{rowNames(c.mode)[i]}</dt>
                  <dd>{cap(part)}</dd>
                </div>
              ))}
            </dl>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Who it's for</p>
        <h2 class="h2">Guides by audience</h2>
      </div>
      <div class="people">
        {
          suited.map((p) => (
            <a class="person" href={personaHref(p.key)}>
              <AudienceIcon name={p.key} />
              <span>
                <b>{p.name}</b>
                <span class="small">{p.pitch}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section last">
    <div class="wrap">
      <div class="cta">
        <p class="eyebrow">Try it</p>
        <h2 class="h2">Twenty minutes to a first verdict.</h2>
        <p class="lede">Install it on one computer, or ask your own AI agent to:</p>
        <Cmd prompt="›" text="Set up Thermite on this computer for me: follow https://usethermite.com/llm-setup.txt" />
        <div class="btns">
          <a class="btn primary" href="/tutorials/first-run/">Install on one machine</a>
          <a class="btn" href="/tutorials/your-own-project/">Start on your own project</a>
        </div>
      </div>
    </div>
  </section>
</Site>

<style>
  .hero {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 3vw, 2.25rem);
    background: radial-gradient(60% 90% at 90% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%);
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    margin: 0 0 0.9rem;
  }
  .switch {
    display: flex;
    gap: 0.35rem;
    margin: 0 0 2rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .switch::-webkit-scrollbar {
    display: none;
  }
  .switch a {
    padding: 0.28rem 0.75rem;
    border: 1px solid var(--rule-2);
    border-radius: 999px;
    background: var(--panel);
    color: var(--ink-2);
    font-size: 0.83rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .switch a:hover {
    border-color: var(--dim);
  }
  .switch a[aria-current="page"] {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
  }
  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--ink);
  }
  .crumbs [aria-current] {
    color: var(--ink-2);
  }
  .title {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .title {
    margin-bottom: 1rem;
  }
  .title .eyebrow {
    margin: 0;
  }
  .hero .h1 {
    max-width: 50rem;
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 3.3rem);
  }
  .hero .lede {
    max-width: 46rem;
  }
  .hero .btns {
    margin-top: 1.5rem;
  }
  .cases {
    padding-top: clamp(1.25rem, 3vw, 2rem);
  }
  .list {
    display: grid;
    gap: 0.9rem;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) auto;
    gap: 1.5rem 2.5rem;
    align-items: start;
    padding: 1.5rem 1.6rem;
    border: 1px solid var(--rule);
    border-radius: 16px;
    background: var(--panel);
    text-decoration: none;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .row:hover {
    border-color: var(--rule-2);
    background: var(--panel-2);
  }
  .row .h3 {
    margin: 0.8rem 0 0;
    font-size: 1.3rem;
    line-height: 1.25;
  }
  .row p {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .row .for {
    margin-top: 0.8rem;
    font-size: 0.82rem;
    color: var(--dim);
  }
  .spec {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0.2rem 0 0 1.5rem;
    border-left: 1px solid var(--rule);
    font-size: 0.88rem;
  }
  .spec div {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 0.6rem;
  }
  .spec dt {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    color: var(--dim);
    padding-top: 0.15rem;
  }
  .spec dd {
    margin: 0;
    color: var(--ink-2);
  }
  .go {
    align-self: center;
    font-size: 1.3rem;
    color: var(--accent);
    transition: transform 0.2s;
  }
  .row:hover .go {
    transform: translateX(3px);
  }
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 0.75rem;
  }
  .person {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--panel);
    text-decoration: none;
  }
  .person:hover {
    border-color: var(--rule-2);
  }
  .person b {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }
  .person .small {
    display: block;
    margin-top: 0.25rem;
  }
  .last {
    padding-top: 0;
    border-top: 0 !important;
  }
  .cta .cmd {
    margin-top: 1.25rem;
  }
  @media (max-width: 52rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
    .spec {
      padding: 1rem 0 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
    .go {
      display: none;
    }
  }
</style>

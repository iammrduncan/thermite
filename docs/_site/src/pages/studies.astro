---
// The case studies' listing. Each study's full page is in the documentation (studies/), where
// llms.txt and the Markdown copies carry it too.
import ClimbReplay from "../components/site/ClimbReplay.astro";
import Partners from "../components/site/Partners.astro";
import Site from "../layouts/Site.astro";

const study = "/studies/qwen3-8-27b-on-a-p100/";
const campaigns = [
  { n: 1, mode: "goal", title: "Support the format", when: "15–22 Oct", result: "Every goal met · 7.74 tok/s" },
  { n: 2, mode: "goal", title: "The quality gate", when: "22–23 Oct", result: "11 of 12 · the miss explained" },
  { n: 3, mode: "climb", title: "Decode speed", when: "24–29 Oct", result: "3.89× · 30.06 tok/s" },
  { n: 4, mode: "climb", title: "Prompt speed", when: "from 2 Nov", result: "+16% so far · running" },
];
const modeName: Record<string, string> = { climb: "hill climb", goal: "goal" };
---

<Site
  title="Case studies: real Thermite campaigns, with the judge's numbers"
  description="Real campaigns Thermite has run: the question, the modes, the judge's own numbers, what the agents found, and what was not measured."
  section="studies"
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Case studies</p>
      <h1 class="h1">Real campaigns. The judge's own numbers.</h1>
      <p class="lede">
        Campaigns Thermite has run, from the first question to the last verdict.
      </p>
    </div>
  </section>

  <section class="feature-wrap">
    <div class="wrap">
      <article class="feature" data-reveal>
        <div class="feature-text">
          <Partners />
          <p class="kicker mono">Local AI · Inference engine · 4 campaigns</p>
          <h2 class="h2"><a href={study}>Qwen3.8-27B on a $100 GPU, 3.9× faster</a></h2>
          <p class="lede">
            Four campaigns tuned an inference engine for Qwen3.8-27B on one Tesla P100. In the decode climb alone, agents
            proposed 131 changes to the engine; the judge confirmed 28, and held the model's
            answers where they started. tensorless ships the result in one command.
          </p>
          <ol class="timeline">
            {
              campaigns.map((c) => (
                <li>
                  <span class="num mono">{c.n}</span>
                  <span class={`tag ${c.mode}`}>{modeName[c.mode]}</span>
                  <b>{c.title}</b>
                  <span class="when mono">{c.when}</span>
                  <span class="res">{c.result}</span>
                </li>
              ))
            }
          </ol>
          <div class="btns">
            <a class="btn primary" href={study}>Read the study</a>
            <a class="btn" href="https://tensorless.dev">Run it with tensorless</a>
          </div>
        </div>
        <div class="feature-art">
          <ClimbReplay compact />
        </div>
      </article>
    </div>
  </section>

  <section class="section last">
    <div class="wrap">
      <div class="cta" data-reveal>
        <p class="eyebrow">Share yours</p>
        <h2 class="h2">Ran a campaign worth a study?</h2>
        <p class="lede">Bring its numbers to the Hackers in the Loop Discord. The next study could be yours.</p>
        <div class="btns">
          <a class="btn primary" href="https://discord.gg/3Qs2uejUf9">Join the Discord</a>
          <a class="btn" href="/use-cases/">See the use cases</a>
        </div>
      </div>
    </div>
  </section>
</Site>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3rem);
    background: radial-gradient(60% 90% at 90% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%);
  }
  .hero .h1 {
    max-width: 50rem;
  }
  .feature-wrap {
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(1.4rem, 3vw, 2.25rem);
    border: 1px solid var(--rule-2);
    border-radius: 24px;
    background: var(--panel);
    box-shadow: var(--shadow);
  }
  @media (max-width: 62rem) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .kicker {
    margin: 1.25rem 0 0;
    font-size: 0.74rem;
    color: var(--dim);
    letter-spacing: 0.04em;
  }
  .feature .h2 {
    margin-top: 0.5rem;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
  }
  .feature .h2 a {
    text-decoration: none;
  }
  .feature .h2 a:hover {
    color: var(--accent);
  }
  .timeline {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }
  .timeline li {
    display: grid;
    grid-template-columns: 1.4rem 6rem 1fr auto;
    gap: 0.15rem 0.75rem;
    align-items: center;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9rem;
  }
  .num {
    color: var(--dim);
    font-size: 0.78rem;
  }
  .timeline .tag {
    justify-content: center;
  }
  .when {
    font-size: 0.74rem;
    color: var(--dim);
  }
  .res {
    grid-column: 3 / -1;
    color: var(--muted);
    font-size: 0.84rem;
  }
  @media (max-width: 30rem) {
    .timeline li {
      grid-template-columns: 1.2rem 1fr auto;
    }
    .timeline .tag {
      display: none;
    }
    .res {
      grid-column: 2 / -1;
    }
  }
  .last {
    padding-top: 0;
    border-top: 0 !important;
  }
</style>

---
// One command to copy, with its prompt sign. The copy button works through src/scripts/site.ts.
interface Props {
  text: string;
  prompt?: string;
}
const { text, prompt = "$" } = Astro.props;
---

<div class="cmd">
  {prompt && <span class="prompt" aria-hidden="true">{prompt}</span>}
  <code>{text}</code>
  <button class="copy" type="button" data-copy={text} aria-label={`Copy: ${text}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><rect x="8" y="8" width="12" height="12" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"></rect><path
        d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"></path></svg
    >
    <span data-label>Copy</span>
  </button>
</div>

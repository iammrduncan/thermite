---
// The home page's use cases: the fields, each a link into the overview, and a card for each
// persona with a few of its use cases. Every use case is a page in the documentation.
import { useCasePages } from "../../data/use-case-pages";
import { fields, personaHref, personas } from "../../data/use-cases.mjs";
import AudienceIcon from "./AudienceIcon.astro";
import FieldIcon from "./FieldIcon.astro";

const cases = await useCasePages();
const withCases = fields.filter((f) => cases.some((c) => c.field === f.key));
// Each persona's card shows three use cases from different fields, in the fields' order.
const picks = (key: string) => {
  const seen = new Set<string>();
  return cases.filter((c) => c.personas.includes(key) && !seen.has(c.field) && seen.add(c.field)).slice(0, 3);
};
---

<nav class="fields" aria-label="Use cases by field">
  {
    withCases.map((f) => (
      <a href={`/use-cases/${f.key}/`}>
        <FieldIcon name={f.key} />
        <span>{f.short ?? f.label}</span>
      </a>
    ))
  }
</nav>

<div class="grid four">
  {
    personas.map((p) => (
      <div class="card persona">
        <AudienceIcon name={p.key} />
        <h3 class="h3">{p.name}</h3>
        <p>{p.pitch}</p>
        <ul>
          {picks(p.key).map((c) => (
            <li>
              <a href={c.href}>{c.title}</a>
            </li>
          ))}
        </ul>
        <a class="go" href={personaHref(p.key)}>
          Read the guide
        </a>
      </div>
    ))
  }
</div>

<style>
  .fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 1.5rem;
  }
  .fields a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.3rem 0.9rem 0.3rem 0.3rem;
    border: 1px solid var(--rule-2);
    border-radius: 14px;
    background: var(--panel);
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 540;
  }
  .fields a:hover {
    border-color: var(--accent);
    color: var(--ink);
  }
  .fields :global(.fi) {
    width: 2rem;
    height: 2rem;
    border-radius: 9px;
  }
  .fields :global(.fi svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .persona {
    display: flex;
    flex-direction: column;
  }
  .persona .h3 {
    margin-top: 1rem;
  }
  ul {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 0.5rem;
  }
  li {
    display: grid;
    gap: 0.3rem;
    justify-items: start;
    font-size: 0.9rem;
    line-height: 1.35;
  }
  li a {
    color: var(--ink-2);
    text-decoration: none;
  }
  li a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .persona .go {
    margin-top: auto;
    padding-top: 1.1rem;
    text-decoration: none;
  }
</style>

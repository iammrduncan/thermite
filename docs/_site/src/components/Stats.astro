---
// A row of headline numbers, for the home page and the studies: each tile is one measured value
// with what it measures. The values are text, so they read the same to a screen reader, in the
// Markdown copy's neighbours and when copied.
interface Props {
  items: { value: string; label: string; note?: string }[];
  caption?: string;
}
const { items, caption } = Astro.props;
---

<figure class="stats not-content">
  <dl>
    {
      items.map((item) => (
        <div class="tile">
          <dt>{item.label}</dt>
          <dd class="value">{item.value}</dd>
          {item.note && <dd class="note">{item.note}</dd>}
        </div>
      ))
    }
  </dl>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .stats {
    margin: 1.5rem 0;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 0.75rem;
    margin: 0;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-top: 3px solid var(--sl-color-accent);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
  }
  :global(:root[data-theme="light"]) .tile {
    background: var(--sl-color-gray-7);
  }
  dt {
    order: 2;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    line-height: 1.35;
  }
  dd {
    margin: 0;
  }
  .value {
    order: 1;
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--sl-color-white);
  }
  .note {
    order: 3;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>

{
  "argv": [
    "/usr/local/bin/claude",
    "--model",
    "claude-opus-5-5",
    "--permission-mode",
    "bypassPermissions",
    "--session-id",
    "89fec18e-dc2d-4619-8bca-25bfaee885ca",
    "--strict-mcp-config",
    "--debug-file",
    "/scratch/thermite/lanes/lane-1/claude-inbox/out/claude-debug.log",
    "--setting-sources",
    "user",
    "--disallowedTools",
    "AskUserQuestion",
    "--messaging-socket-path",
    "/scratch/thermite/lanes/lane-1/claude-inbox/claude-inbox/inbox.sock",
    "--",
    "SPIKE-2: run pwd please."
  ],
  "cols": 120,
  "rows": 40,
  "steps": [
    {
      "do": "mark",
      "label": "turn-a"
    },
    {
      "do": "wait",
      "for": "standin",
      "marker": "SPIKE-2",
      "kind": "tool",
      "step": 1,
      "timeoutMs": 60000,
      "label": "sleep 6 handed out"
    },
    {
      "do": "sleep",
      "ms": 1500
    },
    {
      "do": "uds",
      "path": "/scratch/thermite/lanes/lane-1/claude-inbox/claude-inbox/inbox.sock",
      "lines": [
        {
          "type": "user",
          "message": {
            "role": "user",
            "content": "STEER-2 through the messaging socket, mid-turn."
          }
        }
      ]
    },
    {
      "do": "wait",
      "for": "standin",
      "marker": "SPIKE-2",
      "kind": "text",
      "timeoutMs": 60000,
      "label": "turn a reply"
    },
    {
      "do": "wait",
      "for": "signal",
      "event": "Stop",
      "since": "mark",
      "timeoutMs": 30000,
      "label": "turn a ended"
    },
    {
      "do": "wait",
      "for": "quiet",
      "ms": 2000,
      "timeoutMs": 20000
    },
    {
      "do": "snap",
      "label": "after turn a"
    },
    {
      "do": "mark",
      "label": "turn-b socket idle"
    },
    {
      "do": "uds",
      "path": "/scratch/thermite/lanes/lane-1/claude-inbox/claude-inbox/inbox.sock",
      "lines": [
        {
          "type": "user",
          "message": {
            "role": "user",
            "content": "SPIKE-5 through the messaging socket while idle: run date."
          }
        }
      ]
    },
    {
      "do": "wait",
      "for": "standin",
      "marker": "SPIKE-5",
      "kind": "text",
      "timeoutMs": 30000,
      "label": "an idle socket message starts a turn?"
    },
    {
      "do": "wait",
      "for": "signal",
      "event": "Stop",
      "since": "mark",
      "timeoutMs": 20000,
      "label": "turn b ended"
    },
    {
      "do": "wait",
      "for": "quiet",
      "ms": 2000,
      "timeoutMs": 20000
    },
    {
      "do": "snap",
      "label": "after turn b"
    },
    {
      "do": "mark",
      "label": "turn-c interrupt"
    },
    {
      "do": "type",
      "text": "SPIKE-3: run the very slow command."
    },
    {
      "do": "wait",
      "for": "standin",
      "marker": "SPIKE-3",
      "kind": "tool",
      "step": 1,
      "timeoutMs": 60000,
      "label": "sleep 40 handed out"
    },
    {
      "do": "sleep",
      "ms": 3000
    },
    {
      "do": "key",
      "key": "esc"
    },
    {
      "do": "wait",
      "for": "quiet",
      "ms": 3000,
      "timeoutMs": 20000
    },
    {
      "do": "snap",
      "label": "after esc"
    },
    {
      "do": "sleep",
      "ms": 3000
    },
    {
      "do": "mark",
      "label": "turn-d limit"
    },
    {
      "do": "type",
      "text": "SPIKE-4: this call hits the usage limit."
    },
    {
      "do": "wait",
      "for": "standin",
      "marker": "SPIKE-4",
      "kind": "error429",
      "timeoutMs": 60000,
      "label": "429 handed out"
    },
    {
      "do": "wait",
      "for": "quiet",
      "ms": 3000,
      "timeoutMs": 20000
    },
    {
      "do": "snap",
      "label": "after 429"
    },
    {
      "do": "wait",
      "for": "standin",
      "marker": "SPIKE-4",
      "kind": "text",
      "timeoutMs": 150000,
      "label": "auto-continue after the reset"
    },
    {
      "do": "wait",
      "for": "quiet",
      "ms": 3000,
      "timeoutMs": 20000
    },
    {
      "do": "snap",
      "label": "after the limit"
    },
    {
      "do": "mark",
      "label": "ending ctrl-c"
    },
    {
      "do": "key",
      "key": "ctrl-c"
    },
    {
      "do": "wait",
      "for": "quiet",
      "ms": 1500,
      "timeoutMs": 5000
    },
    {
      "do": "snap",
      "label": "after one ctrl-c"
    },
    {
      "do": "key",
      "key": "ctrl-c",
      "times": 2,
      "gapMs": 300
    },
    {
      "do": "wait",
      "for": "exit",
      "timeoutMs": 10000
    }
  ]
}

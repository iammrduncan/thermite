{
  "argv": [
    "/usr/local/bin/claude",
    "--model",
    "claude-opus-5-5",
    "--permission-mode",
    "bypassPermissions",
    "--session-id",
    "ba9b2294-be6c-4474-b020-ae2f978beef8",
    "--strict-mcp-config",
    "--debug-file",
    "/scratch/thermite/lanes/lane-1/claude-resume/out/claude-debug.log",
    "--setting-sources",
    "user",
    "--disallowedTools",
    "AskUserQuestion",
    "--",
    "SPIKE-2: run pwd please."
  ],
  "cols": 120,
  "rows": 40,
  "steps": [
    {
      "do": "mark",
      "label": "turn-a"
    },
    {
      "do": "wait",
      "for": "signal",
      "event": "Stop",
      "since": "mark",
      "timeoutMs": 60000
    },
    {
      "do": "wait",
      "for": "quiet",
      "ms": 2000,
      "timeoutMs": 10000
    },
    {
      "do": "mark",
      "label": "kill"
    },
    {
      "do": "signal",
      "pid": "program",
      "signal": "SIGKILL"
    },
    {
      "do": "wait",
      "for": "exit",
      "timeoutMs": 5000,
      "afterExit": true
    },
    {
      "do": "snap",
      "label": "after SIGKILL",
      "afterExit": true
    },
    {
      "do": "sh",
      "cmd": "ls -la $HOME/.claude/projects/*/ ; tail -c 600 $HOME/.claude/projects/*/*.jsonl",
      "afterExit": true
    },
    {
      "do": "mark",
      "label": "resume",
      "afterExit": true
    },
    {
      "do": "respawn",
      "argv": [
        "/usr/local/bin/claude",
        "--model",
        "claude-opus-5-5",
        "--permission-mode",
        "bypassPermissions",
        "--resume",
        "ba9b2294-be6c-4474-b020-ae2f978beef8",
        "--strict-mcp-config",
        "--debug-file",
        "/scratch/thermite/lanes/lane-1/claude-resume/out/claude-debug.log",
        "--setting-sources",
        "user",
        "--disallowedTools",
        "AskUserQuestion"
      ],
      "clear": true,
      "afterExit": true
    },
    {
      "do": "wait",
      "for": "quiet",
      "ms": 3000,
      "timeoutMs": 20000
    },
    {
      "do": "snap",
      "label": "after --resume"
    },
    {
      "do": "mark",
      "label": "turn-b"
    },
    {
      "do": "type",
      "text": "SPIKE-5: run date please."
    },
    {
      "do": "wait",
      "for": "signal",
      "event": "Stop",
      "since": "mark",
      "timeoutMs": 30000
    },
    {
      "do": "wait",
      "for": "quiet",
      "ms": 2000,
      "timeoutMs": 10000
    },
    {
      "do": "snap",
      "label": "after turn b"
    },
    {
      "do": "mark",
      "label": "ending"
    },
    {
      "do": "type",
      "text": "/exit"
    },
    {
      "do": "wait",
      "for": "exit",
      "timeoutMs": 10000
    }
  ]
}

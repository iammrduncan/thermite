{
  "argv": [
    "/usr/local/bin/opencode",
    "--server",
    "http://127.0.0.1:4096",
    "--auto",
    "--prompt",
    "SPIKE-3: run the very slow command.",
    "/scratch/thermite/lanes/lane-1/opencode-interrupt/repo"
  ],
  "cols": 120,
  "rows": 40,
  "steps": [
    {
      "do": "mark",
      "label": "startup"
    },
    {
      "do": "wait",
      "for": "signal",
      "src": "opencode-plugin",
      "event": "session.created",
      "since": "start",
      "timeoutMs": 20000
    },
    {
      "do": "http",
      "url": "${server}/api/session",
      "headers": {
        "authorization": "${auth}"
      },
      "extract": {
        "session": "\"id\":\"(ses_[^\"]+)\""
      },
      "keep": 300
    },
    {
      "do": "sse",
      "name": "opencode-session-log",
      "url": "${server}/api/experimental/session/${session}/log?follow=true&after=0",
      "headers": {
        "authorization": "${auth}"
      }
    },
    {
      "do": "wait",
      "for": "standin",
      "marker": "SPIKE-3",
      "kind": "tool",
      "step": 1,
      "timeoutMs": 60000,
      "label": "sleep 40 handed out"
    },
    {
      "do": "mark",
      "label": "esc twice"
    },
    {
      "do": "sleep",
      "ms": 3000
    },
    {
      "do": "key",
      "key": "esc",
      "times": 2,
      "gapMs": 200
    },
    {
      "do": "wait",
      "for": "signal",
      "src": "opencode-plugin",
      "event": "shell.exited",
      "since": "mark",
      "timeoutMs": 6000,
      "label": "did Esc Esc stop the command?"
    },
    {
      "do": "snap",
      "label": "after esc esc"
    },
    {
      "do": "mark",
      "label": "interrupt via server"
    },
    {
      "do": "http",
      "method": "POST",
      "url": "${server}/api/session/${session}/interrupt",
      "headers": {
        "authorization": "${auth}"
      }
    },
    {
      "do": "wait",
      "for": "signal",
      "src": "opencode-plugin",
      "event": "shell.exited",
      "since": "mark",
      "timeoutMs": 8000,
      "label": "did the server's interrupt stop the command?"
    },
    {
      "do": "wait",
      "for": "quiet",
      "ms": 2000,
      "timeoutMs": 10000
    },
    {
      "do": "snap",
      "label": "after the server's interrupt"
    },
    {
      "do": "mark",
      "label": "turn2"
    },
    {
      "do": "http",
      "method": "POST",
      "url": "${server}/api/session/${session}/prompt",
      "headers": {
        "authorization": "${auth}"
      },
      "body": {
        "text": "SPIKE-2: run pwd please.",
        "delivery": "queue"
      }
    },
    {
      "do": "wait",
      "for": "standin",
      "marker": "SPIKE-2",
      "kind": "text",
      "timeoutMs": 30000
    },
    {
      "do": "wait",
      "for": "signal",
      "src": "opencode-plugin",
      "event": "session.execution.succeeded",
      "since": "mark",
      "timeoutMs": 20000
    },
    {
      "do": "http",
      "url": "${server}/api/experimental/session/${session}/log?after=0",
      "headers": {
        "authorization": "${auth}"
      },
      "saveAs": "session-log-after0.sse",
      "keep": 300
    },
    {
      "do": "mark",
      "label": "ending"
    },
    {
      "do": "key",
      "key": "ctrl-c"
    },
    {
      "do": "wait",
      "for": "exit",
      "timeoutMs": 5000,
      "label": "ctrl-c exits?"
    },
    {
      "do": "snap",
      "label": "after ctrl-c"
    }
  ]
}

# A stand-in machine for testing control-managed rigs: Debian with an SSH server and a user
# "thermite" that may sudo without a password. Tests only; never deployed. Control's key is
# added to ~thermite/.ssh/authorized_keys by the test once control has made it. With git, it also
# stands in for a private Git host reached over SSH with a deploy key (campaign acceptance).
FROM docker.io/library/debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-server sudo curl ca-certificates git \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -s /bin/sh thermite \
 && echo 'thermite ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/thermite \
 && chmod 0440 /etc/sudoers.d/thermite \
 && install -d -m 0700 -o thermite -g thermite /home/thermite/.ssh \
 && install -m 0600 -o thermite -g thermite /dev/null /home/thermite/.ssh/authorized_keys \
 && mkdir -p /run/sshd \
 && ssh-keygen -A \
 && printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\nPermitRootLogin no\n' > /etc/ssh/sshd_config.d/thermite.conf
EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]

{
  "schema_version": 1,
  "name": "smoke-cuda",
  "target": "cuda-gpu",
  "build": {
    "copy": [
      "bench"
    ],
    "command": [
      "sh",
      ".kit/bench/build.sh"
    ],
    "outputs": [
      "out/bench"
    ],
    "timeout_s": 300,
    "rss_mib": 2048,
    "disk_mib": 512
  },
  "cells": {
    "small": {
      "n": 1024,
      "reps": 1000,
      "seed": 11,
      "work": 2147483648000
    },
    "large": {
      "n": 2048,
      "reps": 200,
      "seed": 23,
      "work": 3435973836800
    },
    "held": {
      "n": 1536,
      "reps": 400,
      "seed": 37,
      "work": 2899102924800
    }
  },
  "run": {
    "command": [
      "{build:out/bench}",
      "{params}",
      "{out}"
    ],
    "timeout_s": 120,
    "rss_mib": 2048,
    "disk_mib": 64
  },
  "metrics": {
    "flops_per_s": {
      "unit": "FLOP/s",
      "work": "work"
    }
  },
  "check": {
    "command": [
      "node",
      "{kit:check.mjs}",
      "{params_json}",
      "{out}"
    ],
    "timeout_s": 300
  }
}
